---
import BaseLayout from '../layouts/BaseLayout.astro';
import JobCard from '../components/JobCard.astro';
import { getCollection } from 'astro:content';
import { dateKey } from '../lib/dates';

const all = await getCollection('experience');
const active = all
  .filter((e) => !e.data.archived)
  .sort((a, b) => dateKey(b.data.start) - dateKey(a.data.start));
const archived = all
  .filter((e) => e.data.archived)
  .sort((a, b) => dateKey(b.data.start) - dateKey(a.data.start));
---
<BaseLayout title="Work — Giovanni Claudio" description="12+ years across medical robotics, autonomous vehicles and humanoid platforms.">
  <section class="max-w-5xl mx-auto px-6 py-16">
    <header class="mb-10">
      <h1 class="text-4xl font-bold mb-3">Work</h1>
      <p class="text-lg muted max-w-2xl">
        Twelve-plus years architecting real-time perception, computer vision and AI/video systems — from humanoid research at INRIA to surgical robotics at Medtronic.
      </p>
    </header>

    <div class="space-y-6">
      {active.map((entry) => <JobCard entry={entry} />)}
    </div>

    {archived.length > 0 && (
      <details class="mt-12">
        <summary class="subtitle cursor-pointer text-sm select-none">
          Show earlier roles ({archived.length}) ▸
        </summary>
        <div class="mt-6 space-y-6">
          {archived.map((entry) => <JobCard entry={entry} />)}
        </div>
      </details>
    )}
  </section>
</BaseLayout>
