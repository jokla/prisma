---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatRange } from '../lib/dates';
import { getAsset } from '../lib/assets';
import { getLocationFlag } from '../lib/location';
import WorkProjectCard from './WorkProjectCard.astro';
import YouTubeEmbed from './YouTubeEmbed.astro';

interface Props {
  entry: CollectionEntry<'experience'>;
  relatedProjects?: CollectionEntry<'projects'>[];
}
const { entry, relatedProjects = [] } = Astro.props;
const d = entry.data;
const range = formatRange(d.start, d.end);
const logo = d.images?.[0] ? getAsset(d.images[0].src) : undefined;
const locationFlag = getLocationFlag(d.location);
const visibleHighlights = d.highlights.slice(0, 3);
const extraHighlights = d.highlights.slice(3);
const roleVideos = d.youtube ?? [];

function firstSentence(text: string): string {
  const normalized = text.replace(/\s+/g, ' ').trim();
  const match = normalized.match(/^.*?[.!?](?:\s|$)/);
  return match?.[0].trim() ?? normalized;
}

const snapshot = firstSentence(d.summary);
const showcaseCount = relatedProjects.length + roleVideos.length;
---
<article class="surface rounded-[1.5rem] p-6 md:p-8">
  <header class="flex flex-col gap-6 lg:flex-row lg:items-start">
    {logo && (
      <div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-[1.25rem] border bg-white p-3 shadow-sm" style="border-color: var(--color-border)">
        <Image src={logo} alt={d.images?.[0].alt ?? ''} width={80} height={80} class="max-h-full max-w-full object-contain" />
      </div>
    )}
    <div class="min-w-0 flex-1">
      <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
        <div class="min-w-0">
          <p class="subtitle text-xs uppercase tracking-[0.24em]">Work Chapter</p>
          <h3 class="mt-2 text-2xl font-bold leading-tight">{d.role}</h3>
          <p class="mt-2 text-lg">
            {d.website ? <a href={d.website} target="_blank" rel="noopener">{d.company}</a> : d.company}
          </p>
        </div>

        <div class="flex flex-wrap gap-2 text-sm">
          <span class="rounded-full border px-3 py-1.5" style="border-color: var(--color-border); background: var(--color-bg)">
            {range}
          </span>
          <span class="inline-flex items-center gap-2 rounded-full border px-3 py-1.5" style="border-color: var(--color-border); background: var(--color-bg)">
            {locationFlag && <span aria-hidden="true">{locationFlag}</span>}
            <span>{d.location}</span>
          </span>
        </div>
      </div>

      <p class="mt-4 max-w-3xl text-base leading-relaxed">{snapshot}</p>

      {d.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {d.tags.map((tag) => (
            <span class="rounded-full px-2.5 py-1 text-xs" style="background: var(--color-bg); color: var(--color-fg-muted); border: 1px solid var(--color-border)">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </header>

  {visibleHighlights.length > 0 && (
    <div class="mt-6 grid gap-3 md:grid-cols-3">
      {visibleHighlights.map((item) => (
        <div class="rounded-[1rem] border p-4 text-sm leading-relaxed" style="border-color: var(--color-border); background: var(--color-bg)">
          {item}
        </div>
      ))}
    </div>
  )}

  {showcaseCount > 0 && (
    <section class="mt-8 border-t pt-6" style="border-color: var(--color-border)">
      <div class="mb-5 flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="subtitle text-xs uppercase tracking-[0.24em]">Show, Don't Tell</p>
          <h4 class="text-lg font-bold">Selected footage and project work</h4>
        </div>
        <p class="text-sm muted">{showcaseCount} visual proof point{showcaseCount === 1 ? '' : 's'}</p>
      </div>

      {roleVideos.length > 0 && (
        <div class="mb-4 grid gap-4 md:grid-cols-2">
          {roleVideos.map((video) => (
            <YouTubeEmbed id={video.id} label={video.label ?? d.company} kicker="Role Footage" />
          ))}
        </div>
      )}

      {relatedProjects.length > 0 && (
        <div class="grid gap-4 xl:grid-cols-2">
          {relatedProjects.map((project) => <WorkProjectCard entry={project} />)}
        </div>
      )}
    </section>
  )}

  <details class="mt-6 group">
    <summary class="subtitle cursor-pointer text-sm select-none">
      Open role notes {(extraHighlights.length > 0 || d.summary) ? `(${extraHighlights.length + 1})` : ''} ▸
    </summary>
    <div class="mt-4 grid gap-4 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
      <p class="text-sm leading-relaxed">{d.summary}</p>

      {extraHighlights.length > 0 && (
        <ul class="list-disc space-y-2 pl-5 text-sm leading-relaxed">
          {extraHighlights.map((item) => <li>{item}</li>)}
        </ul>
      )}
    </div>
  </details>
</article>
