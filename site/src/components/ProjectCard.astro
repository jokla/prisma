---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatRange } from '../lib/dates';
import { getAsset } from '../lib/assets';

interface Props {
  entry: CollectionEntry<'projects'>;
}
const { entry } = Astro.props;
const d = entry.data;
const range = formatRange(d.start, d.end);
const hero = d.images?.[0] ? getAsset(d.images[0].src) : undefined;
---
<article class="surface rounded-lg overflow-hidden flex flex-col">
  {hero && (
    <div class="aspect-[16/10] overflow-hidden" style="background: var(--color-bg)">
      <Image src={hero} alt={d.images?.[0].alt ?? ''} width={640} height={400} class="w-full h-full object-cover" />
    </div>
  )}
  <div class="p-6 flex-1 flex flex-col">
    <h3 class="text-lg font-bold">
      {d.url ? <a href={d.url} target="_blank" rel="noopener">{d.name}</a> : d.name}
    </h3>
    {d.subtitle && <p class="text-sm muted mt-1">{d.subtitle}</p>}
    <p class="text-xs muted mt-2">
      {d.organisation && <span>{d.organisation}</span>}
      {range && <span>{d.organisation && ' · '}{range}</span>}
    </p>
    {d.summary && <p class="mt-3 text-sm leading-relaxed flex-1">{d.summary}</p>}
    {d.stack && d.stack.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {d.stack.map((s) => (
          <span class="text-xs px-2 py-0.5 rounded" style="background: var(--color-bg); color: var(--color-fg-muted); border: 1px solid var(--color-border)">{s}</span>
        ))}
      </div>
    )}
  </div>
</article>
