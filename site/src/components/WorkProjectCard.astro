---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatRange } from '../lib/dates';
import { getAsset } from '../lib/assets';
import { getLocationFlag } from '../lib/location';
import YouTubeEmbed from './YouTubeEmbed.astro';

interface Props {
  entry: CollectionEntry<'projects'>;
  accordionGroup?: string;
}

const { entry, accordionGroup } = Astro.props;
const d = entry.data;
const videos = d.youtube ?? [];
const featuredVideo = videos[0];
const additionalVideos = featuredVideo ? videos.slice(1) : [];
const coverImage = d.images?.[0] ? getAsset(d.images[0].src) : undefined;
const hasSnapshotMedia = Boolean(featuredVideo || coverImage);
const range = formatRange(d.start, d.end);
const locationFlag = d.location ? getLocationFlag(d.location) : undefined;
const stack = d.stack ?? [];
const highlights = d.highlights ?? [];
const contentTags = d.tags ?? [];
const detailTags = [...new Set([...stack, ...contentTags])];
const meta = [d.organisation, range].filter(Boolean).join(' · ');
const galleryImages = (featuredVideo ? d.images ?? [] : d.images?.slice(1) ?? []).flatMap((image) => {
  const asset = getAsset(image.src);
  return asset ? [{ ...image, asset }] : [];
});
const lightboxItems = JSON.stringify(galleryImages.map((image) => ({ src: image.asset.src, alt: image.alt })));
const panelId = `work-project-panel-${d.id}`;
const lightboxId = `work-project-lightbox-${d.id}`;

function videoLabel(index: number): string {
  return videos[index]?.label ?? `${d.name} demo ${index + 1}`;
}

const expandItems = [
  highlights.length > 0 ? `${highlights.length} highlight${highlights.length === 1 ? '' : 's'}` : undefined,
  additionalVideos.length > 0 ? `${additionalVideos.length} more video${additionalVideos.length === 1 ? '' : 's'}` : undefined,
  galleryImages.length > 0 ? `${galleryImages.length} photo${galleryImages.length === 1 ? '' : 's'}` : undefined,
].filter(Boolean);
---
<article class="work-project-card surface overflow-hidden rounded-[1.25rem]" data-accordion-group={accordionGroup} data-project-card-id={d.id} data-expanded="false">
  {hasSnapshotMedia && (
    <div class="relative aspect-[16/10] overflow-hidden" style="background: linear-gradient(135deg, color-mix(in srgb, var(--color-accent) 16%, var(--color-bg-elev)), var(--color-bg-elev))">
      {featuredVideo ? (
        <YouTubeEmbed id={featuredVideo.id} label={videoLabel(0)} roundedClass="rounded-none" showOverlayKicker={false} />
      ) : (
        <Image src={coverImage!} alt={d.images?.[0].alt ?? ''} width={720} height={450} class="h-full w-full object-cover transition-transform duration-300 work-project-card__cover" />
      )}

      {!featuredVideo && (
        <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 bg-gradient-to-t from-black/70 to-transparent p-4 text-white">
          <div>
            <p class="text-xs uppercase tracking-[0.22em] text-white/70">Project Snapshot</p>
            <p class="mt-1 text-sm font-semibold">{d.name}</p>
            {d.subtitle && <p class="mt-1 text-xs text-white/80">{d.subtitle}</p>}
          </div>
        </div>
      )}
    </div>
  )}

  <div class="p-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div class="min-w-0">
        <p class="subtitle text-xs uppercase tracking-[0.24em]">Project</p>
        <h4 class="mt-2 text-lg font-bold leading-tight">{d.name}</h4>
        {meta && <p class="mt-1 text-xs muted">{meta}</p>}
      </div>

      {d.location && (
        <span
          class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs"
          style="border-color: var(--color-border); background: var(--color-bg)"
        >
          {locationFlag && <span aria-hidden="true">{locationFlag}</span>}
          <span>{d.location}</span>
        </span>
      )}
    </div>

    {d.summary && <p class="mt-4 text-sm leading-relaxed">{d.summary}</p>}

    <div class="mt-4 flex items-center justify-between gap-3 rounded-[999px] border px-4 py-3 text-sm transition-colors duration-200" style="border-color: var(--color-border); background: var(--color-bg)">
      <div class="min-w-0">
        <p class="font-semibold" style="color: var(--color-fg)">Expand project</p>
        {expandItems.length > 0 && <p class="muted text-xs">{expandItems.join(' · ')}</p>}
      </div>
      <button
        type="button"
        class="work-project-card__toggle shrink-0 rounded-full border px-3 py-1.5 font-semibold no-underline"
        style="border-color: var(--color-border); color: var(--color-fg); background: var(--color-bg)"
        data-project-card-toggle={d.id}
        data-accordion-group={accordionGroup}
        aria-expanded="false"
        aria-controls={panelId}
      >
        <span>Expand</span>
        <span class="work-project-card__chevron ml-2 inline-block text-sm muted" aria-hidden="true">▾</span>
      </button>
    </div>
  </div>

  <div class="work-project-card__panel" id={panelId}>
    <div class="work-project-card__panel-inner border-t px-5 pb-5 pt-5" style="border-color: var(--color-border)">
      {detailTags.length > 0 && (
        <section>
          <p class="subtitle text-xs uppercase tracking-[0.24em]">Tags</p>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {detailTags.map((item) => (
              <span class="rounded-full px-2.5 py-1 text-xs" style="background: var(--color-bg); color: var(--color-fg-muted); border: 1px solid var(--color-border)">
                {item}
              </span>
            ))}
          </div>
        </section>
      )}

      {highlights.length > 0 && (
        <section class="mt-6">
          <p class="subtitle text-xs uppercase tracking-[0.24em]">Highlights</p>
          <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed">
            {highlights.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      )}

      {additionalVideos.length > 0 && (
        <section class="mt-6">
          <div class="mb-3 flex items-end justify-between gap-3">
            <div>
              <p class="subtitle text-xs uppercase tracking-[0.24em]">More Videos</p>
            </div>
          </div>
          <div class="grid gap-4 xl:grid-cols-2">
            {additionalVideos.map((video, index) => (
              <div class="space-y-2">
                <YouTubeEmbed id={video.id} label={videoLabel(index + 1)} showOverlayText={false} />
                <p class="text-sm muted">{videoLabel(index + 1)}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      {galleryImages.length > 0 && (
        <section class="mt-6">
          <p class="subtitle text-xs uppercase tracking-[0.24em]">Gallery</p>
          <div class="mt-3 grid gap-4 sm:grid-cols-2">
            {galleryImages.map((image) => (
              <button
                type="button"
                class="work-project-card__gallery-trigger overflow-hidden rounded-[1rem] border text-left transition-transform duration-200"
                style="border-color: var(--color-border); background: var(--color-bg)"
                data-gallery-lightbox-trigger={lightboxId}
                data-gallery-image-index={String(galleryImages.findIndex((candidate) => candidate.asset.src === image.asset.src))}
                data-gallery-image-src={image.asset.src}
                data-gallery-image-alt={image.alt}
              >
                <figure>
                  <Image src={image.asset} alt={image.alt} width={720} height={450} class="aspect-[16/10] w-full object-cover" />
                  <figcaption class="px-4 py-3 text-sm muted">{image.alt}</figcaption>
                </figure>
              </button>
            ))}
          </div>

          <dialog id={lightboxId} class="work-project-card__lightbox" data-gallery-images={lightboxItems} data-gallery-current-index="0">
            <div class="work-project-card__lightbox-toolbar">
              <button type="button" class="work-project-card__lightbox-nav" data-lightbox-nav="prev" aria-label="Show previous image">Previous</button>
              <p class="work-project-card__lightbox-counter" aria-live="polite"></p>
              <div class="flex items-center gap-2">
                <button type="button" class="work-project-card__lightbox-nav" data-lightbox-nav="next" aria-label="Show next image">Next</button>
                <button type="button" class="work-project-card__lightbox-close" aria-label="Close image preview">Close</button>
              </div>
            </div>
            <figure class="work-project-card__lightbox-figure">
              <img src="" alt="" class="work-project-card__lightbox-image" />
              <figcaption class="work-project-card__lightbox-caption"></figcaption>
            </figure>
          </dialog>
        </section>
      )}

      {d.url && (
        <div class="mt-6 flex flex-wrap gap-2 text-sm">
          <a
            href={d.url}
            target="_blank"
            rel="noopener"
            class="rounded-full border px-3 py-1.5 no-underline"
            style="border-color: var(--color-border); color: var(--color-fg)"
          >
            Open project link
          </a>
        </div>
      )}
    </div>
  </div>
</article>

<script>
  function setExpanded(card, expanded) {
    if (!(card instanceof HTMLElement)) return;

    card.dataset.expanded = expanded ? 'true' : 'false';
    const button = card.querySelector('.work-project-card__toggle');
    if (button instanceof HTMLButtonElement) {
      button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      const label = button.querySelector('span');
      if (label) label.textContent = expanded ? 'Collapse' : 'Expand';
    }
  }

  if (!window.__workProjectAccordionBound) {
    window.__workProjectAccordionBound = true;
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const button = target.closest('.work-project-card__toggle');
      if (!(button instanceof HTMLButtonElement)) return;

      const card = button.closest('.work-project-card');
      if (!(card instanceof HTMLElement)) return;

      const isExpanded = card.dataset.expanded === 'true';
      const nextExpanded = !isExpanded;
      const group = card.dataset.accordionGroup;

      if (nextExpanded && group) {
        const selector = `.work-project-card[data-accordion-group="${group}"]`;
        for (const other of document.querySelectorAll(selector)) {
          if (other !== card && other instanceof HTMLElement) {
            setExpanded(other, false);
          }
        }
      }

      setExpanded(card, nextExpanded);
    });
  }

  function getLightboxItems(dialog) {
    if (!(dialog instanceof HTMLDialogElement)) return [];

    try {
      const value = dialog.dataset.galleryImages;
      return value ? JSON.parse(value) : [];
    } catch {
      return [];
    }
  }

  function renderLightbox(dialog, index) {
    if (!(dialog instanceof HTMLDialogElement)) return;

    const items = getLightboxItems(dialog);
    if (!Array.isArray(items) || items.length === 0) return;

    const normalizedIndex = ((index % items.length) + items.length) % items.length;
    dialog.dataset.galleryCurrentIndex = String(normalizedIndex);

    const image = dialog.querySelector('.work-project-card__lightbox-image');
    const caption = dialog.querySelector('.work-project-card__lightbox-caption');
    const counter = dialog.querySelector('.work-project-card__lightbox-counter');
    const prevButton = dialog.querySelector('[data-lightbox-nav="prev"]');
    const nextButton = dialog.querySelector('[data-lightbox-nav="next"]');
    if (!(image instanceof HTMLImageElement) || !(caption instanceof HTMLElement) || !(counter instanceof HTMLElement)) return;

    const item = items[normalizedIndex];
    image.src = item.src;
    image.alt = item.alt;
    caption.textContent = item.alt;
    counter.textContent = `${normalizedIndex + 1} / ${items.length}`;

    if (prevButton instanceof HTMLButtonElement) prevButton.disabled = items.length <= 1;
    if (nextButton instanceof HTMLButtonElement) nextButton.disabled = items.length <= 1;
  }

  function openLightbox(dialog, index) {
    if (!(dialog instanceof HTMLDialogElement)) return;

    renderLightbox(dialog, index);
    dialog.showModal();
  }

  function stepLightbox(dialog, direction) {
    if (!(dialog instanceof HTMLDialogElement)) return;
    const current = Number.parseInt(dialog.dataset.galleryCurrentIndex ?? '0', 10);
    renderLightbox(dialog, current + direction);
  }

  if (!window.__workProjectLightboxBound) {
    window.__workProjectLightboxBound = true;
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const trigger = target.closest('[data-gallery-lightbox-trigger]');
      if (trigger instanceof HTMLButtonElement) {
        const dialogId = trigger.dataset.galleryLightboxTrigger;
        const index = Number.parseInt(trigger.dataset.galleryImageIndex ?? '0', 10);
        if (!dialogId) return;
        const dialog = document.getElementById(dialogId);
        openLightbox(dialog, index);
        return;
      }

      const navButton = target.closest('[data-lightbox-nav]');
      if (navButton instanceof HTMLButtonElement) {
        const dialog = navButton.closest('dialog');
        if (!(dialog instanceof HTMLDialogElement)) return;
        stepLightbox(dialog, navButton.dataset.lightboxNav === 'next' ? 1 : -1);
        return;
      }

      const closeButton = target.closest('.work-project-card__lightbox-close');
      if (closeButton instanceof HTMLButtonElement) {
        closeButton.closest('dialog')?.close();
        return;
      }

      if (target instanceof HTMLDialogElement && target.classList.contains('work-project-card__lightbox')) {
        const rect = target.getBoundingClientRect();
        const clickedInside = rect.top <= event.clientY && event.clientY <= rect.bottom && rect.left <= event.clientX && event.clientX <= rect.right;
        if (!clickedInside) target.close();
      }
    });

    document.addEventListener('keydown', (event) => {
      const openDialogs = [...document.querySelectorAll('.work-project-card__lightbox[open]')].filter(
        (dialog) => dialog instanceof HTMLDialogElement,
      );
      if (openDialogs.length === 0) return;

      if (event.key === 'Escape') {
        for (const dialog of openDialogs) {
          if (dialog instanceof HTMLDialogElement) dialog.close();
        }
        return;
      }

      if (event.key === 'ArrowRight') {
        for (const dialog of openDialogs) {
          if (dialog instanceof HTMLDialogElement) stepLightbox(dialog, 1);
        }
      }

      if (event.key === 'ArrowLeft') {
        for (const dialog of openDialogs) {
          if (dialog instanceof HTMLDialogElement) stepLightbox(dialog, -1);
        }
      }
    });
  }
</script>

<style>
  .work-project-card:hover .work-project-card__cover,
  .work-project-card[data-expanded='true'] .work-project-card__cover {
    transform: scale(1.03);
  }

  .work-project-card {
    transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease;
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-accent) 0%, transparent);
  }

  .work-project-card:hover,
  .work-project-card[data-expanded='true'] {
    border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-border));
    box-shadow: 0 16px 40px -28px color-mix(in srgb, var(--color-accent) 45%, transparent), 0 0 0 1px color-mix(in srgb, var(--color-accent) 28%, transparent);
    transform: translateY(-2px);
  }

  .work-project-card__panel {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    visibility: hidden;
    transition: max-height 260ms ease, opacity 200ms ease, visibility 0s linear 260ms;
  }

  .work-project-card[data-expanded='true'] .work-project-card__panel {
    max-height: 240rem;
    opacity: 1;
    visibility: visible;
    transition: max-height 320ms ease, opacity 240ms ease;
  }

  .work-project-card__panel-inner {
    overflow: hidden;
  }

  .work-project-card__chevron {
    transition: transform 220ms ease;
  }

  .work-project-card[data-expanded='true'] .work-project-card__chevron {
    transform: rotate(180deg);
  }

  .work-project-card__toggle:hover {
    border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-border));
    color: var(--color-accent);
  }

  .work-project-card__gallery-trigger:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-border));
  }

  .work-project-card__lightbox {
    position: fixed;
    inset: 0;
    margin: auto;
    max-width: min(92vw, 1100px);
    width: min(92vw, 1100px);
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, var(--color-border));
    border-radius: 1.25rem;
    background: var(--color-bg-elev);
    color: var(--color-fg);
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.45);
  }

  .work-project-card__lightbox::backdrop {
    background: rgba(7, 10, 18, 0.75);
    backdrop-filter: blur(8px);
  }

  .work-project-card__lightbox-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1rem 0;
  }

  .work-project-card__lightbox-counter {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-fg-muted);
  }

  .work-project-card__lightbox-nav,
  .work-project-card__lightbox-close {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    color: var(--color-fg);
    padding: 0.45rem 0.8rem;
    font-size: 0.85rem;
  }

  .work-project-card__lightbox-nav:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .work-project-card__lightbox-figure {
    margin: 0;
    display: flex;
    min-height: min(78vh, 900px);
    flex-direction: column;
    justify-content: center;
  }

  .work-project-card__lightbox-image {
    display: block;
    width: 100%;
    max-height: 78vh;
    object-fit: contain;
    background: #0a0c12;
  }

  .work-project-card__lightbox-caption {
    padding: 1rem 1.25rem 1.1rem;
    font-size: 0.95rem;
    color: var(--color-fg-muted);
  }
</style>