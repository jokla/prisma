---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
}
const { entry } = Astro.props;
const { title, pubDate, description } = entry.data;
---
<BaseLayout title={`${title} — Giovanni Claudio`} description={description}>
  <article class="max-w-3xl mx-auto px-6 py-16">
    <a href="/blog/" class="text-sm no-underline muted">← Back to blog</a>
    <header class="mt-6 mb-10">
      <h1 class="text-4xl font-bold leading-tight mb-3">{title}</h1>
      <time datetime={pubDate.toISOString()} class="text-sm muted">
        {pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
    </header>
    <div class="prose prose-lg dark:prose-invert max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
